# -------------------------------------------------------
# STEP 1 SETUP: Your Secret API Keys
# -------------------------------------------------------
# This file is a TEMPLATE. Do the following:
#   1. Copy this file and rename the copy to just:  .env
#   2. Fill in your real keys below
#   3. Never share your .env file with anyone
#
# -------------------------------------------------------
# REQUIRED: YouTube API Key
# -------------------------------------------------------
# How to get one (free):
#   1. Go to https://console.cloud.google.com/
#   2. Create a new project (e.g. "market-voice")
#   3. Search for "YouTube Data API v3" and click Enable
#   4. Go to Credentials → Create Credentials → API Key
#   5. Paste your key below
# -------------------------------------------------------
YOUTUBE_API_KEY=YOUR_YOUTUBE_KEY_HERE

# -------------------------------------------------------
# OPTIONAL: Anthropic API Key (for smarter phrase generation)
# -------------------------------------------------------
# If you add this key, Step 1A will use Claude to generate
# smarter, more varied YouTube search phrases.
# If you leave this blank, a simple rule-based fallback is
# used instead — the script will still work fine.
#
# How to get one:
#   1. Go to https://console.anthropic.com/
#   2. Sign up or log in
#   3. Go to API Keys → Create Key
#   4. Paste your key below
# -------------------------------------------------------
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE

# -------------------------------------------------------
# OPTIONAL: Claude Model (only matters if ANTHROPIC_API_KEY is set)
# -------------------------------------------------------
# This controls which Claude model is used for phrase generation.
# The default (claude-haiku-4-5) is fast and low-cost.
# You can change it to a more powerful model if you want.
# Available options:
#   claude-haiku-4-5      (default — fast and cheap)
#   claude-sonnet-4-6     (smarter, moderate cost)
#   claude-opus-4-6       (most powerful, higher cost)
# -------------------------------------------------------
CLAUDE_MODEL=claude-haiku-4-5
